# Copy to .env and replace token before starting. Do not commit .env.
OPERATOR_TOKEN=replace-with-a-random-token-at-least-24-characters
POSTGRES_PASSWORD=local-coursework-postgres
RABBITMQ_PASSWORD=local-coursework-rabbit
HTTP_PORT=8080
